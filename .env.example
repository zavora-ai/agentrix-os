PORT=9847
HOST=127.0.0.1
RUST_LOG=info

# Public URL (production — used for OAuth redirects and AWP discovery)
# BASE_URL=https://os.zavora.example

# Copy to .env — or put secrets in .env.local, which is loaded first and git-ignored.
# Gemini (required for real agents, deck workflow, and live voice)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# M10 — Gemini Live voice (requires GOOGLE_API_KEY)
GEMINI_LIVE_MODEL=models/gemini-3.8-live
VOICE_NAME=Aoede
# M10-T5 — camera channel over /ws/voice (frames to Gemini Live, gestures back). 0 hides the button.
AGENTRIX_CAMERA=1

# MCP server binaries (built with `cargo build --release` in each repo)
MCP_WORKSHEET_PATH=../mcp-servers/worksheet-mcp/target/release/excel-mcp-server
MCP_DOCX_PATH=../mcp-servers/docx-mcp/target/release/docx-mcp-server
MCP_SLIDES_PATH=../mcp-servers/mcp-slides/target/release/slides-mcp-server

# MCP Phase B — morning / live / ambient scenarios
MCP_CALENDAR_PATH=../mcp-servers/mcp-calendar/target/release/mcp-calendar
MCP_EMAIL_PATH=../mcp-servers/mcp-email/target/release/mcp-email
MCP_NEWS_PATH=../mcp-servers/mcp-news/target/release/mcp-news
MCP_WEATHER_PATH=../mcp-servers/mcp-weather/target/release/mcp-weather

# MCP Phase C — people, week, lisbon, proactive (optional)
MCP_SLACK_PATH=../mcp-servers/mcp-slack/target/release/mcp-slack
MCP_CRM_PATH=../mcp-servers/mcp-crm/target/release/mcp-crm
MCP_MARKET_DATA_PATH=../mcp-servers/mcp-market-data/target/release/mcp-market-data
MCP_BANKING_PATH=../mcp-servers/mcp-banking/target/release/mcp-banking
MCP_GITHUB_PATH=../mcp-servers/mcp-github/target/release/adk-mcp-github
MCP_MAPS_PATH=../mcp-servers/mcp-maps/target/release/mcp-maps
MCP_REAL_ESTATE_PATH=../mcp-servers/mcp-real-estate/target/release/mcp-real-estate

# Optional: calendar/email OAuth (or run `mcp-calendar auth google`, `mcp-email auth gmail`)
# GOOGLE_CALENDAR_TOKEN=
# GNEWS_API_KEY=

ARTIFACT_DIR=./artifacts

# M9 — Postgres + auth (optional; omit to keep in-memory sessions)
# docker compose up -d
# DATABASE_URL=postgres://spatial_os:spatial_os@localhost:5434/spatial_os
# JWT_SECRET=change-me-in-production
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Without Google OAuth creds, use "Dev sign in" in the UI (POST /api/auth/dev).

# M9 — MCP registry sync (optional; requires built mcp-registry binary)
# MCP_REGISTRY_PATH=../mcp-servers/mcp-registry/target/release/mcp-registry

# M11 — deploy (deploy/docker-compose.yml)
# BASE_URL=https://os.zavora.example
# DOMAIN=os.zavora.example
# POSTGRES_PASSWORD=change-me-in-production
# AGENTRIX_ALLOW_DEMO=0
# AGENTRIX_SIGNUP_ENDPOINT=https://formspree.io/f/your-id
# AGENTRIX_LINKEDIN_PARTNER_ID=10281097
# AGENTRIX_LINKEDIN_CONVERSION_ID=28504817
# Phase 2 — Personal AI OS (R1 foundation)
# Master key for encrypting sensitive memory values at rest (S3). Any long random string; rotate = re-key.
# MEMORY_MASTER_KEY=change-me-to-a-long-random-string
# Key for hashing subjects in the content-free activity ledger (S2).
# LEDGER_HASH_KEY=change-me-too
# Work Mother fold (S4): set to 0 to fall back to direct per-target fan-out during validation.
# AGENTRIX_WORK_MOTHER=1
# Home Mother fold (S5): set to 0 to fall back to direct fan-out. Contacts CSV (name,relation,birthday) until migration 009.
# AGENTRIX_HOME_MOTHER=1
# CONTACTS_CSV_PATH=./contacts.csv
